# ── IBM watsonx.ai credentials ──────────────────────────────────────────
# Get your API key from https://cloud.ibm.com/iam/apikeys
WATSONX_API_KEY=your-ibm-cloud-api-key-here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=your-watsonx-project-id-here

# ── Granite model ───────────────────────────────────────────────────────
GRANITE_MODEL_ID=ibm/granite-3-3-8b-instruct
GRANITE_MAX_NEW_TOKENS=1024
GRANITE_TEMPERATURE=0.2

# ── Sandbox configuration ──────────────────────────────────────────────
SANDBOX_MODE=subprocess
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_MAX_MEMORY_MB=512
SANDBOX_DOCKER_IMAGE=python:3.11-slim

# ── Mutation engine ────────────────────────────────────────────────────
MAX_MUTATIONS_PER_FILE=50
AI_MUTATIONS_PER_FILE=5

# ── Server ─────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
CORS_ORIGINS=*

# ── Upload limits ──────────────────────────────────────────────────────
UPLOAD_MAX_SIZE_MB=50
